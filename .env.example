# Generate secure, URL-safe values with: python scripts/init_env.py
POSTGRES_DB=crm_course_v3
POSTGRES_USER=crm_owner
POSTGRES_PASSWORD=GENERATE_A_UNIQUE_URL_SAFE_SECRET
MIGRATION_DB_USER=crm_migrator
MIGRATION_DB_PASSWORD=GENERATE_A_UNIQUE_URL_SAFE_SECRET
APP_DB_USER=crm_app
APP_DB_PASSWORD=GENERATE_A_UNIQUE_URL_SAFE_SECRET
DATABASE_URL=postgresql+psycopg://crm_app:GENERATE_A_UNIQUE_URL_SAFE_SECRET@localhost:5432/crm_course_v3
JWT_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_40_CHARACTERS
CORS_ORIGINS=["http://localhost:3000"]
ENVIRONMENT=development
APP_IMAGE=construction-crm:local
